---
import type { CollectionEntry } from "astro:content";
import ProjectCard from "./ProjectCard.astro";
import ProjectFilters from "./ProjectFilters.astro";

interface Props {
  projects: CollectionEntry<"projects">[];
  heading?: string;
  intro?: string;
  showFilters?: boolean;
}

const {
  projects,
  heading = "All case studies",
  intro = "Production systems explained through the problem, technical approach, and measurable result.",
  showFilters = true,
} = Astro.props;
const filters = ["BlinkRx", "Apartments.com", "Healthcare", "Distributed Systems", "Integrations", "Reliability", "AI"];
---

<section class="case-study-index" aria-labelledby="projects-title">
  <header class="page-heading">
    <p class="eyebrow">Case studies</p>
    <h1 id="projects-title">{heading}</h1>
    <p>{intro}</p>
  </header>
  {showFilters && <ProjectFilters filters={filters} />}
  <div class="project-list">
    {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
  </div>
</section>
