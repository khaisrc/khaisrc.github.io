---
import type { CollectionEntry } from 'astro:content';
import CaseStudyCard from './CaseStudyCard.astro';
import CaseStudyFilters from './CaseStudyFilters.astro';

interface Props {
  caseStudies: CollectionEntry<'caseStudies'>[];
  heading?: string;
  intro?: string;
  showFilters?: boolean;
}

const {
  caseStudies,
  heading = 'All case studies',
  intro = 'Production systems explained through the problem, technical approach, and measurable result.',
  showFilters = true,
} = Astro.props;
const filters = [
  'BlinkRx',
  'Apartments.com',
  'Healthcare',
  'Distributed Systems',
  'Integrations',
  'Reliability',
  'AI',
];
---

<section class='case-study-index' aria-labelledby='case-studies-title'>
  <header class='page-heading'>
    <p class='eyebrow'>Case studies</p>
    <h1 id='case-studies-title'>{heading}</h1>
    <p>{intro}</p>
  </header>
  {showFilters && <CaseStudyFilters filters={filters} />}
  <div class='case-study-list'>
    {
      caseStudies.map((caseStudy, index) => (
        <CaseStudyCard caseStudy={caseStudy} index={index} />
      ))
    }
  </div>
</section>
