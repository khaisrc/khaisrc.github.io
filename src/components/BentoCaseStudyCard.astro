---
import type { CollectionEntry } from "astro:content";
import { ArrowUpRight } from "@lucide/astro";

interface Props {
  project: CollectionEntry<"projects">;
  variant: "lead" | "wide";
  area: string;
}

const { project, variant, area } = Astro.props;
const { data } = project;
const metric = data.metrics[0];
---

<article class:list={["bento-tile", "bento-project", `bento-project-${variant}`]} style={`--bento-area: ${area}`}>
  <div>
    <p class="tile-kicker">{data.company} · {data.areas[0]}</p>
    <h2><a href={`/case-studies/${project.id}/`}>{data.title}</a></h2>
    <p class="tile-description">{data.description}</p>
  </div>
  <div class="tile-footer">
    {metric && (
      <p class="tile-metric"><strong>{metric.value}</strong><span>{metric.label}</span></p>
    )}
    <a class="tile-link" href={`/case-studies/${project.id}/`} aria-label={`Read ${data.title} case study`}>
      Read case study <ArrowUpRight size={15} aria-hidden="true" />
    </a>
  </div>
</article>
