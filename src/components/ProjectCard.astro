---
import type { CollectionEntry } from "astro:content";
import { ArrowUpRight } from "@lucide/astro";

interface Props {
  project: CollectionEntry<"projects">;
  index: number;
}

const { project, index } = Astro.props;
const { data } = project;
const filters = [data.company, ...data.areas].join("|").toLowerCase();
---

<article class="project-card" data-project data-filters={filters}>
  <span class="card-number">{String(index + 1).padStart(2, "0")}</span>
  <p class="project-company">{data.company}</p>
  <h3><a href={`/projects/${project.id}/`}>{data.title}</a></h3>
  <p class="project-description">{data.description}</p>
  <ul class="tech-list" aria-label="Technology stack">
    {data.techStack.slice(0, 6).map((tech) => <li class="tech-item">{tech}</li>)}
  </ul>
  {data.metrics.length > 0 && (
    <div class="card-metrics" aria-label="Selected metrics">
      {data.metrics.slice(0, 3).map((metric) => (
        <div>
          <span class="card-metric-value">{metric.value}</span>
          <span class="card-metric-label">{metric.label}</span>
        </div>
      ))}
    </div>
  )}
  <a class="card-link" href={`/projects/${project.id}/`} aria-label={`Read ${data.title} case study`}>
    View case study <ArrowUpRight size={15} />
  </a>
</article>
