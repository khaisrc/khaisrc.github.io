---
import previews from "../data/link-previews.json";

interface Props {
  url: string;
}

const { url } = Astro.props;
const meta = (previews as Record<string, { title: string; description: string | null; image: string | null; domain: string; favicon: string }>)[url];
---

{meta ? (
  <a class="link-preview" href={url} target="_blank" rel="noreferrer">
    {meta.image && (
      <div class="link-preview-image">
        <img src={meta.image} alt="" loading="lazy" decoding="async" />
      </div>
    )}
    <div class="link-preview-body">
      <span class="link-preview-domain">
        <img class="link-preview-favicon" src={meta.favicon} alt="" width="14" height="14" loading="lazy" decoding="async" />
        {meta.domain}
      </span>
      <span class="link-preview-title">{meta.title}</span>
      {meta.description && <span class="link-preview-description">{meta.description}</span>}
    </div>
  </a>
) : (
  <a href={url} target="_blank" rel="noreferrer">{url}</a>
)}

<style>
  .link-preview {
    display: block;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    text-decoration: none;
    background: var(--surface);
    transition: border-color 150ms ease;
    margin-block: 1.5rem;
  }

  .link-preview:hover {
    border-color: var(--ring);
  }

  .link-preview-image {
    border-bottom: 1px solid var(--border);
    overflow: hidden;
    line-height: 0;
  }

  .link-preview-image img {
    width: 100%;
    height: auto;
    display: block;
    max-height: 16rem;
    object-fit: cover;
  }

  .link-preview-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: var(--space-s) var(--space-m);
  }

  .link-preview-domain {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--muted-foreground);
    font-size: var(--step--1);
  }

  .link-preview-favicon {
    display: inline-block;
    border-radius: 2px;
  }

  .link-preview-title {
    color: var(--foreground);
    font-weight: 500;
    font-size: var(--step-0);
    line-height: 1.3;
  }

  .link-preview-description {
    color: var(--muted-foreground);
    font-size: var(--step--1);
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
