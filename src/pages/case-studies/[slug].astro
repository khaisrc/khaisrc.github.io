---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { ArrowLeft, ExternalLink } from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import InteractiveDiagram from "../../components/InteractiveDiagram.astro";

export async function getStaticPaths() {
  const caseStudies = (await getCollection("caseStudies", ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order,
  );

  return caseStudies.map((caseStudy) => ({
    params: { slug: caseStudy.id },
    props: { caseStudy },
  }));
}

interface Props {
  caseStudy: CollectionEntry<"caseStudies">;
}

const { caseStudy } = Astro.props;
const { Content, headings } = await render(caseStudy);
const sectionHeadings = headings.filter((heading) => heading.depth === 2);
---

<BaseLayout title={`${caseStudy.data.title} | Khai Nguyen`} description={caseStudy.data.description}>
  <article class="case-study-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/case-studies/"><ArrowLeft size={14} aria-hidden="true" /> All case studies</a>
    </nav>

    <header class="case-study-header">
      <p class="eyebrow">{caseStudy.data.company}</p>
      <h1>{caseStudy.data.title}</h1>
      <p class="case-study-summary">{caseStudy.data.summary}</p>
      <ul class="tag-list" aria-label="Technology stack">
        {caseStudy.data.techStack.map((tech) => <li>{tech}</li>)}
      </ul>
      <dl class="case-study-meta">
        <div><dt>Company</dt><dd>
          {caseStudy.data.companyUrl ? (
            <a href={caseStudy.data.companyUrl} target="_blank" rel="noreferrer">{caseStudy.data.company} <ExternalLink size={13} aria-hidden="true" /></a>
          ) : caseStudy.data.company}
        </dd></div>
        <div><dt>Focus</dt><dd>{caseStudy.data.areas.join(", ")}</dd></div>
      </dl>
    </header>

    {caseStudy.data.metrics.length > 0 && (
      <section class="metrics-list" aria-labelledby="outcomes-title">
        <h2 id="outcomes-title" class="sr-only">Case study outcomes</h2>
        {caseStudy.data.metrics.map((metric) => (
          <div class="metric-item">
            <strong>{metric.value}</strong>
            <span>{metric.label}</span>
            {metric.context && <small>{metric.context}</small>}
          </div>
        ))}
      </section>
    )}

    {caseStudy.data.diagram && <InteractiveDiagram {...caseStudy.data.diagram} />}

    <div class:list={["case-study-body", sectionHeadings.length === 0 && "case-study-body-no-nav"]}>
      <div class="prose"><Content /></div>
      {sectionHeadings.length > 0 && (
        <aside class="case-study-toc" aria-label="On this page">
          <p>On this page</p>
          <ol>
            {sectionHeadings.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
          </ol>
        </aside>
      )}
    </div>

  </article>
</BaseLayout>
