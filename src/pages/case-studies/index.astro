---
import { getCollection } from "astro:content";
import CaseStudies from "../../components/CaseStudies.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const caseStudies = (await getCollection("caseStudies", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout pageTitle="Case Studies" description="Engineering case studies across backend platforms, distributed systems, healthcare, real estate, and lending.">
  <CaseStudies caseStudies={caseStudies} heading="All case studies" intro="A case-study record of systems, integrations, product workflows, and operational improvements." />
</BaseLayout>
