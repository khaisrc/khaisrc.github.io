---
import { getCollection } from "astro:content";
import ProjectIndex from "../../components/ProjectIndex.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title="Projects | Khai Nguyen" description="Engineering case studies across backend platforms, distributed systems, healthcare, real estate, and lending.">
  <div style="padding-top: 18px">
    <ProjectIndex projects={projects} heading="All engineering projects" intro="A project-by-project record of systems, integrations, product workflows, and operational improvements." />
  </div>
</BaseLayout>
