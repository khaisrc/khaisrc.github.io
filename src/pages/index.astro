---
import { getCollection } from "astro:content";
import BentoGrid from "../components/BentoGrid.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const caseStudies = (await getCollection("caseStudies", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const homePicks = [
  "prescription-service",
  "erx-patient-data-agent",
  "resident-community-messaging",
];
const featured = homePicks
  .map((id) => caseStudies.find((caseStudy) => caseStudy.id === id))
  .filter((caseStudy): caseStudy is (typeof caseStudies)[number] => Boolean(caseStudy));
---

<BaseLayout>
  <BentoGrid caseStudies={featured} />
</BaseLayout>
