---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Things I've learned | Khai Nguyen" description="A short collection of lessons learned.">
  <section class="shell" style="min-height: calc(100vh - 216px); padding-block: 90px;">
    <p class="eyebrow">Notes</p>
    <h1 style="max-width: 760px; font-size: clamp(2.5rem, 7vw, 5rem);">Things I've learned in life</h1>
    <div class="prose" style="max-width: 680px; margin-top: 45px;">
      <ul>
        <li>Don't promise when you're happy.</li>
        <li>Good things don't last forever. But neither do bad ones.</li>
      </ul>
    </div>
  </section>
</BaseLayout>
