---
import { BriefcaseBusiness, CodeXml, Download } from "@lucide/astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Khai Nguyen | Staff-Level Software Engineer",
  description = "Project-based engineering portfolio covering backend platforms, distributed systems, integrations, and reliable production operations.",
  image = "/social-card.png",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7f3" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="Khai Nguyen, home">
          <span class="brand-mark" aria-hidden="true">KN</span>
          <span>Khai Nguyen</span>
        </a>
        <div class="nav-links">
          <a class="nav-link" href="/case-studies/">Case Studies</a>
          <a class="nav-link" href="/about/">About</a>
        </div>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <div>
          <p class="footer-title">Khai Nguyen</p>
          <p class="footer-copy">Backend platforms, distributed systems, and product engineering.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
